{
  "name": "uploadkit",
  "version": "0.1.0",
  "description": "Install UploadKit into an existing project — init, add, restore.",
  "license": "MIT",
  "author": "Drumst0ck",
  "homepage": "https://uploadkit.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drumst0ck/uploadkit.git",
    "directory": "packages/uploadkit-cli"
  },
  "bugs": {
    "url": "https://github.com/drumst0ck/uploadkit/issues"
  },
  "keywords": [
    "uploadkit",
    "cli",
    "init",
    "add",
    "upload",
    "file-upload",
    "next",
    "sveltekit",
    "remix",
    "vite"
  ],
  "type": "module",
  "bin": {
    "uploadkit": "./dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "smoke": "tsx scripts/smoke-matrix.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.2.0",
    "@uploadkitdev/shared": "workspace:*",
    "execa": "^9.6.1",
    "fast-glob": "^3.3.3",
    "magicast": "^0.5.2",
    "mri": "^1.2.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "@uploadkitdev/config": "workspace:*",
    "tsup": "8.5.1",
    "tsx": "4.21.0",
    "typescript": "6.0.2",
    "vitest": "4.1.4"
  }
}
