{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "MONGODB_URI",
    "R2_ACCOUNT_ID",
    "R2_ACCESS_KEY_ID",
    "R2_SECRET_ACCESS_KEY",
    "R2_BUCKET_NAME",
    "IMAGE_TRANSFORM_BASE_URL",
    "IMAGE_TRANSFORM_SECRET",
    "IMAGE_TRANSFORM_PUBLIC_SECRET",
    "SENTRY_DSN",
    "NODE_ENV",
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "CDN_URL",
    "CLOUDFLARE_API_TOKEN",
    "CLOUDFLARE_ZONE_ID",
    "CLOUDFLARE_CNAME_TARGET",
    "CLOUDFLARE_SAAS_FALLBACK",
    "CLOUDFLARE_CDN_FALLBACK",
    "CRON_SECRET",
    "REDIS_URL",
    "AUTH_SECRET",
    "AUTH_URL",
    "AUTH_GITHUB_ID",
    "AUTH_GITHUB_SECRET",
    "AUTH_GOOGLE_ID",
    "AUTH_GOOGLE_SECRET",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_DOCS_URL",
    "NEXT_PHASE",
    "ADMIN_EMAILS",
    "ENCRYPTION_KEY",
    "INTERNAL_API_SECRET",
    "RESEND_API_KEY",
    "STRIPE_PRO_PRICE_ID",
    "STRIPE_TEAM_PRICE_ID",
    "STRIPE_ENTERPRISE_PRICE_ID",
    "QSTASH_TOKEN",
    "QSTASH_CURRENT_SIGNING_KEY",
    "QSTASH_NEXT_SIGNING_KEY",
    "CLOUDFLARE_OAUTH_CLIENT_ID",
    "CLOUDFLARE_OAUTH_CLIENT_SECRET",
    "CLOUDFLARE_OAUTH_DOMAIN",
    "CLOUDFLARE_OAUTH_SCOPES",
    "GOOGLE_SITE_VERIFICATION",
    "X_ADS_ACCESS_TOKEN",
    "X_ADS_ACCESS_TOKEN_SECRET",
    "X_ADS_API_KEY",
    "X_ADS_API_SECRET",
    "X_ADS_PIXEL_ID",
    "X_ADS_PURCHASE_EVENT_ID",
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "persistent": true,
      "cache": false
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    }
  }
}
